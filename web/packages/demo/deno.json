{
  "name": "@ruffle/demo",
  "version": "0.1.0",
  "tasks": {
    "dev": "deno run --allow-all npm:vite@^7.3.1",
    "build": "deno task typecheck && deno run --allow-all npm:vite@^7.3.1 build",
    "typecheck": "deno run --allow-all npm:typescript@^5.9.3/tsc --noEmit",
    "preview": "deno run --allow-all npm:vite@^7.3.1 preview",
    "checkTypes": "deno task typecheck"
  },
  "imports": {
    "react": "npm:react@^19.2.3",
    "react-dom": "npm:react-dom@^19.2.3",
    "ruffle-core": "../core/dist/index.js"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["esnext", "dom", "dom.iterable"]
  }
}
